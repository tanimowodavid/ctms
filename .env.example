POSTGRES_DB=tms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:change-this-local-password@localhost:5432/tms
WORKER_DATABASE_URL=postgresql+psycopg2://postgres:change-this-local-password@db:5432/tms
TEST_DATABASE_URL=postgresql+psycopg2://postgres:change-this-local-password@localhost:5432/ctms_test
CTMS_MIGRATION_TEST_DATABASE_URL=postgresql+psycopg2://postgres:change-this-local-password@localhost:5432/ctms_migration_test
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SETUP_LINK_BASE_URL=http://localhost:3000/setup-password

# Comma-separated origins allowed to submit applications from the hosted widget.
# Example: http://localhost:8080,https://apply.example.org
CORS_ALLOWED_ORIGINS=

# Gmail SMTP: use a Google App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Email worker polling and exponential retry limits.
WORKER_POLL_SECONDS=5
WORKER_RETRY_BASE_SECONDS=30
WORKER_RETRY_MAX_SECONDS=3600
